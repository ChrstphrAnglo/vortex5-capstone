PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>
SECRET=<random-jwt-signing-secret>
MQTT_USERNAME=<hivemq-cloud-username>
MQTT_PASSWORD=<hivemq-cloud-password>
# Gmail SMTP (via Nodemailer) — used to email signup verification codes.
# GMAIL_USER should be a dedicated Google account with 2-Step Verification
# enabled; GMAIL_APP_PASSWORD is a 16-character App Password generated for
# it (not the account's real login password) — see myaccount.google.com/apppasswords
GMAIL_USER=<dedicated-gmail-address>
GMAIL_APP_PASSWORD=<16-char-app-password>
# Optional: set to 1 to enable extra sensor-decoder debug logging
DEBUG_SENSOR=0
